# ── LLM providers (three free tiers, fallback chains — Docs_COMPLEX/ai/LLM_STRATEGY.md) ──
GROQ_API_KEY=            # https://console.groq.com/keys
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey
NVIDIA_API_KEY=          # https://build.nvidia.com (API key from any model page)

# ── App ──
ALAN_API_TOKEN=          # any long random string; bearer token for the API
FERNET_KEY=              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_NAME=you            # what Alan_T calls you

# ── Telegram (single-user gate — both required for the gateway) ──
TELEGRAM_BOT_TOKEN=      # from @BotFather
TELEGRAM_ALLOWED_USER_ID=  # your numeric Telegram user id

# ── Database ──
DATABASE_URL=postgresql+asyncpg://alan:alan@localhost:5432/alan_t
POSTGRES_PASSWORD=alan

# ── Email agent (optional — unset = agent not registered) ──
IMAP_HOST=               # e.g. imap.gmail.com
SMTP_HOST=               # e.g. smtp.gmail.com
EMAIL_ADDRESS=
EMAIL_PASSWORD=          # app password, never your real one (Gmail: myaccount.google.com/apppasswords)

# ── Calendar agent (optional — Google OAuth refresh-token flow, see setup.md) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Research / notifications (optional) ──
BRAVE_API_KEY=           # empty → DuckDuckGo fallback for web_search
NTFY_TOPIC=              # push notifications via ntfy.sh (pick a private random topic)

# ── Voice ──
TTS_VOICE=Kore           # Gemini prebuilt voice for spoken replies

# ── Writable data (defaults fine in Docker; bind-mounted volume persists them) ──
NOTES_DIR=./data/notes
IMAGES_DIR=./data/images
