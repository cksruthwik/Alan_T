# Copy to .env and fill in. NEVER commit .env.

# --- API auth (single-user bearer token) ---
ALAN_API_TOKEN=change-me-to-a-long-random-string

# --- LLM providers (three free tiers behind one LiteLLM seam) ---
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_NIM_API_KEY=

# --- Datastore ---
# In docker compose this points at the postgres service; locally use your own.
DATABASE_URL=postgresql+asyncpg://alan:alan@localhost:5432/alan_t

# --- Memory (Mem0) ---
# Long-term memory uses Groq for fact extraction (GROQ_API_KEY above) + a local Qdrant
# store. Disabled gracefully if GROQ_API_KEY is unset. Keep this on a persistent volume.
ALAN_MEMORY_PATH=.data/memory
# Stable identity memory is keyed by (single-user for now; Telegram user id arrives at M2).
ALAN_USER_ID=default

# --- Optional ---
ALAN_MODELS_CONFIG=config/models.yaml
ALAN_LOG_LEVEL=INFO
